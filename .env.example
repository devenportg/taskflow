# Пример переменных окружения. Настоящий файл .env в Git не попадает.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskflow

# Строка подключения для запусков с хоста: alembic, uvicorn, scripts/smoke_test.py.
# Хост — localhost, проброшенный порт сервиса db. Пароль должен совпадать с POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg2://taskflow:change-me@localhost:5432/taskflow

# Внутри Docker Compose эта строка не используется: там DATABASE_URL собирается
# из POSTGRES_* с хостом db (см. docker-compose.yml).
